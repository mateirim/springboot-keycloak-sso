# Keycloak OAuth2 Configuration
KEYCLOAK_CLIENT_ID=springboot-app
KEYCLOAK_CLIENT_SECRET=your-client-secret-here
KEYCLOAK_ISSUER_URI=https://your-keycloak-domain/realms/your-realm
KEYCLOAK_SERVER_URL=http://keycloak.keycloak.svc.cluster.local
KEYCLOAK_REALM=master
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=your-admin-password

# MongoDB Connection
MONGO_URI=mongodb://admin:password@localhost:27017/app_db?authSource=admin

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:4200

# Application
SERVER_PORT=8080
